* text=auto

*.java text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
*.md text eol=lf
*.csv text eol=lf
*.R text eol=lf
gradlew text eol=lf
*.bat text eol=crlf

# Frozen upstream captures: retain the exact bytes recorded in their manifests.
src/test/resources/org/jlinalg/genetics/prscs-math/*.tsv text eol=lf
src/test/resources/org/jlinalg/genetics/prscs-math/provenance.json -text whitespace=cr-at-eol
src/test/resources/regenie/*.bed binary

# Frozen protein reference captures are checked against their original SHA-256 values.
src/test/resources/org/jlinalg/protein/apbs-grid/* -text whitespace=cr-at-eol
src/test/resources/org/jlinalg/protein/pdb2pqr/* -text whitespace=cr-at-eol
src/test/resources/org/jlinalg/protein/pymol-geometry/* -text whitespace=cr-at-eol
src/test/resources/org/jlinalg/protein/pymol-potential/* -text whitespace=cr-at-eol
src/test/resources/org/jlinalg/protein/pymol-tools/* -text whitespace=cr-at-eol
