{
  "task": "qc",
  "engine": "plink1",
  "home": "build/omics-plink-official",
  "bfile": "examples/plink-tools/qc/known",
  "samples": "examples/plink-tools/qc/qc-samples.tsv",
  "out": "build/examples/plink-qc-plink1",
  "genome-build": "unspecified",
  "chromosome-scope": "autosomes",
  "qc-order": "samples-then-variants",
  "unresolved-alleles": "exclude",
  "maximum-sample-missing": ".1",
  "maximum-variant-missing": ".2",
  "minimum-maf": ".01",
  "minimum-mac": "2",
  "frequency-population": "all",
  "hwe-mode": "exact",
  "hwe-p": "1e-6",
  "hwe-population": "controls",
  "hwe-founders": "all",
  "hwe-unreportable": "exclude",
  "final-check": "fail"
}
