{
  "schema_version": 1,
  "mode": "RUN",
  "edition": "1.3.1",
  "engine": "native",
  "operation": "FDENSITY",
  "out": "build/native-fdensity",
  "inputs": {
    "qtl": {"path": "qtl.bed", "format": "BED"},
    "annotations": {"path": "annotations.bed", "format": "BED"}
  },
  "parameters": {"window": 20, "bin": 10},
  "acknowledge_original_handling": true,
  "limits": {
    "maximum_input_bytes": 100000,
    "maximum_output_bytes": 100000,
    "maximum_rows": 1000,
    "maximum_bins": 100
  }
}
