+	q()
+}
+
+} else {
+if ( opt$verbose >= 1 ) cat("### Skipping heritability estimate\n")
+hsq = opt$hsq_set
+hsq.pv = NA
+}
+
+# read in genotypes
+genos = read_plink(geno.file,impute="avg")
