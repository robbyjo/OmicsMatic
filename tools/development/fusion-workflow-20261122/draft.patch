+import static org.jlinalg.cli.GprofilerWorkflowContracts.require;
+
+/** Owned root and observed-child lifetime; monitored limits are not OS job/RAM quotas. */
+final class FusionWorkflowProcess {
+    private FusionWorkflowProcess(){ }
