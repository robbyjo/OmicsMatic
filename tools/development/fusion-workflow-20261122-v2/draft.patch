+	flip[ref == "A"] = "T"
+	flip[ref == "T"] = "A"
+	flip[ref == "G"] = "C"
+	flip[ref == "C"] = "G"
+	flip2 = flip;
+
+	snp = list()
+	snp[["keep"]] = !((a1=="A" & a2=="T") | (a1=="T" & a2=="A") | (a1=="C" & a2=="G") | (a1=="G" & a2=="C"))
