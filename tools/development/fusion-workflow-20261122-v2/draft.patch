+	# Load weights
+	wgt.file = paste(opt$weights_dir,"/",wgtlist$WGT[w],sep='')
+	load(wgt.file)
+	# Remove NAs (these should not be here)
+	wgt.matrix[is.na(wgt.matrix)] = 0
