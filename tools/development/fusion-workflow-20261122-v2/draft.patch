+}
+
+# Load in reference data
+genos = read_plink(paste(opt$ref_ld_chr,chr,sep=''),impute="avg")
+
+# Match summary data to input, record NA where summary data is missing
+m = match( genos$bim[,2] , sumstat$SNP )
+sum.missing = is.na(m)
