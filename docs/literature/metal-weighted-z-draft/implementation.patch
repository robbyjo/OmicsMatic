index 0000000000000000000000000000000000000000..38a46b4931bd818a1cff6ea794cb511d67e19535
--- /dev/null
+++ b/src/main/java/org/jlinalg/meta/SampleSizeWeightedMetaAnalysis.java
@@ -0,0 +1,115 @@
+/* Copyright (C) 2026 JLinAlg contributors; SPDX-License-Identifier: GPL-3.0-or-later */
+package org.jlinalg.meta;
+
+import jdistlib.ChiSquare;
+import jdistlib.Normal;
+
+/** Independent-cohort, sample-size-weighted signed-Z meta-analysis.
+ *
+ * <p>Weights are caller-declared positive effective sample sizes, not inverse
+ * standard errors. Input statistics must already describe the same tested
+ * allele and hypothesis in mutually independent cohorts. This class neither
+ * harmonizes alleles nor estimates overlap, genomic control or effective N.
+ * It implements the weighted-Z mathematics, not the METAL command interpreter.
+ * Input arrays must remain immutable for the duration of the call.
+ */
+public final class SampleSizeWeightedMetaAnalysis {
+    private static final double LOG_TWO=Math.log(2.0);
+
+    public record Limits(int maximumStudies,long maximumEstimatedBytes) {
+        public Limits {
+            require(maximumStudies>0&&maximumEstimatedBytes>0,"Positive study and estimated-byte limits required");
+        }
+        public static Limits defaults(){return new Limits(1_000_000,128L<<20);}
+    }
+
+    /** No beta/SE in original trait units is inferred from a combined Z.
+     * Heterogeneity P/logP/I2 are null for a single participating cohort.
+     * The I2 percentage uses its ordinary nonnegative convention.
+     * A zero P with a finite log P is retained as numerical underflow.
+     */
+    public record Result(int studies,double totalWeight,double z,double pValue,
+            double logPValue,boolean pValueUnderflow,double heterogeneityQ,
+            int heterogeneityDegreesOfFreedom,Double heterogeneityPValue,
+            Double heterogeneityLogPValue,boolean heterogeneityPValueUnderflow,
+            Double iSquaredPercent,double[] studyZ,double[] squareRootFractionWeights,
+            double[] zContributions,double[] heterogeneityContributions,
+            long estimatedRetainedBytes) {
+        public Result {
+            studyZ=studyZ.clone();squareRootFractionWeights=squareRootFractionWeights.clone();
+            zContributions=zContributions.clone();heterogeneityContributions=heterogeneityContributions.clone();
+        }
+        @Override public double[] studyZ(){return studyZ.clone();}
+        @Override public double[] squareRootFractionWeights(){return squareRootFractionWeights.clone();}
+        @Override public double[] zContributions(){return zContributions.clone();}
+        @Override public double[] heterogeneityContributions(){return heterogeneityContributions.clone();}
+        public boolean heterogeneityDefined(){return heterogeneityDegreesOfFreedom>0;}
+    }
+
+    private SampleSizeWeightedMetaAnalysis(){ }
+    private static void require(boolean ok,String why){if(!ok)throw new IllegalArgumentException(why);}
+    private static double finite(double value){
+        if(!Double.isFinite(value))throw new ArithmeticException("Unrepresentable weighted-Z intermediate/result; no studies or terms removed");
+        return value;
+    }
+    private static long admit(int count,Limits limits){
+        require(limits!=null&&count>0&&count<=limits.maximumStudies(),"Nonempty complete cohort population within declared capacity required");
+        long bytes=Math.addExact(8192L,Math.multiplyExact(128L,count));
+        require(bytes<=limits.maximumEstimatedBytes(),"Complete weighted-Z working/result arrays exceed estimated-byte capacity; no truncation");
+        return bytes;
+    }
+    private static final class Sum {
+        double value,correction;
+        void add(double term){double adjusted=finite(term-correction),next=finite(value+adjusted);correction=finite((next-value)-adjusted);value=next;}
+    }
+
+    public static Result fitSignedZ(double[] z,double[] weights){return fitSignedZ(z,weights,Limits.defaults());}
+
+    /** Uses Z = sum_i sqrt(N_i/sum N) Z_i, retaining every declared cohort.
+     * Heterogeneity is sum_i (Z_i-sqrt(N_i/sum N) Z)^2 under the common
+     * standardized-effect model. No missingness, filtering or sign is inferred.
+     */
+    public static Result fitSignedZ(double[] signedZ,double[] weights,Limits limits){
+        require(signedZ!=null&&weights!=null&&signedZ.length==weights.length,"Matching complete Z and weight arrays required");
+        int n=signedZ.length;long bytes=admit(n,limits);double[] z=signedZ.clone(),w=weights.clone();
+        Sum total=new Sum();for(int i=0;i<n;i++){require(Double.isFinite(z[i])&&Double.isFinite(w[i])&&w[i]>0,"Every cohort needs a finite signed Z and positive finite effective sample size; no omission/imputation");total.add(w[i]);}
+        double root=Math.sqrt(total.value);double[] fraction=new double[n],contribution=new double[n],heterogeneity=new double[n];Sum combined=new Sum();
+        for(int i=0;i<n;i++){
+            // Taking square roots before dividing avoids premature N_i/sum(N)
+            // underflow when a small cohort still has a representable Z term.
+            fraction[i]=finite(Math.sqrt(w[i])/root);contribution[i]=finite(fraction[i]*z[i]);combined.add(contribution[i]);
+        }
+        double result=finite(combined.value);double logP=finite(LOG_TWO+Normal.cumulative(Math.abs(result),0,1,false,true));
+        require(logP<=0,"Invalid normal-tail probability; no P-value clamping");double p=Math.exp(logP);
+        Sum q=new Sum();for(int i=0;i<n;i++){double residual=finite(z[i]-finite(fraction[i]*result));heterogeneity[i]=finite(residual*residual);q.add(heterogeneity[i]);}
+        int df=n-1;Double qP=null,qLogP=null,i2=null;
+        if(df>0){qLogP=finite(ChiSquare.cumulative(q.value,df,false,true));require(qLogP<=0,"Invalid heterogeneity probability; no P-value clamping");qP=Math.exp(qLogP);i2=q.value>df?100.0*(1.0-df/q.value):0.0;}
+        return new Result(n,total.value,result,p,logP,p==0.0,q.value,df,qP,qLogP,qP!=null&&qP==0.0,i2,z,fraction,contribution,heterogeneity,bytes);
+    }
+
+    public static Result fitPValues(double[] twoSidedP,int[] directions,double[] weights){return fitPValues(twoSidedP,directions,weights,Limits.defaults());}
+
+    /** Directions must explicitly be -1 or +1. Exact input P=0 is refused:
+     * supply its finite natural log through fitLogPValues if it underflowed.
+     * P/2 is evaluated in log space rather than underflowing before inversion.
+     */
+    public static Result fitPValues(double[] twoSidedP,int[] directions,double[] weights,Limits limits){
+        require(twoSidedP!=null&&directions!=null&&weights!=null&&twoSidedP.length==directions.length&&weights.length==directions.length,"Matching complete P/direction/weight arrays required");admit(twoSidedP.length,limits);
+        double[] logs=new double[twoSidedP.length];for(int i=0;i<logs.length;i++){double p=twoSidedP[i];require(Double.isFinite(p)&&p>0&&p<=1,"Two-sided P must be in (0,1]; no replacement of zeros, missing or invalid values");logs[i]=Math.log(p);}
+        return fitLogPValues(logs,directions,weights,limits);
+    }
+
+    public static Result fitLogPValues(double[] naturalLogTwoSidedP,int[] directions,double[] weights){return fitLogPValues(naturalLogTwoSidedP,directions,weights,Limits.defaults());}
+
+    /** Finite natural logarithms of two-sided P in (0,1], not -log10(P).
+     * The caller must declare the correct log base before using this method.
+     */
+    public static Result fitLogPValues(double[] naturalLogTwoSidedP,int[] directions,double[] weights,Limits limits){
+        require(naturalLogTwoSidedP!=null&&directions!=null&&weights!=null&&naturalLogTwoSidedP.length==directions.length&&weights.length==directions.length,"Matching complete logP/direction/weight arrays required");admit(directions.length,limits);
+        double[] z=new double[directions.length];for(int i=0;i<z.length;i++){
+            double logP=naturalLogTwoSidedP[i];require(Double.isFinite(logP)&&logP<=0&&(directions[i]==-1||directions[i]==1),"Finite natural logP<=0 and explicit -1/+1 directions required; no sign inference");
+            z[i]=finite(directions[i]*Normal.quantile(finite(logP-LOG_TWO),0,1,false,true));
+        }
+        return fitSignedZ(z,weights,limits);
+    }
+}
diff --git a/src/test/java/org/jlinalg/meta/SampleSizeWeightedMetaAnalysisTest.java b/src/test/java/org/jlinalg/meta/SampleSizeWeightedMetaAnalysisTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..4bb7b794dc76a7e08b0a85bf35c0cfd27f6e2f3e
--- /dev/null
+++ b/src/test/java/org/jlinalg/meta/SampleSizeWeightedMetaAnalysisTest.java
@@ -0,0 +1,57 @@
+/* Copyright (C) 2026 JLinAlg contributors; SPDX-License-Identifier: GPL-3.0-or-later */
+package org.jlinalg.meta;
+
+import java.io.*;
+import java.nio.charset.StandardCharsets;
+import java.lang.reflect.Array;
+import java.util.*;
+import java.util.zip.ZipInputStream;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+
+class SampleSizeWeightedMetaAnalysisTest {
+    static Map<String,String> fixtures()throws Exception {
+        var files=new HashMap<String,String>();try(var raw=SampleSizeWeightedMetaAnalysisTest.class.getResourceAsStream("/org/jlinalg/meta/sample-size-weighted-z/reference-fixtures.zip")){assertNotNull(raw);try(var z=new ZipInputStream(raw)){for(var e=z.getNextEntry();e!=null;e=z.getNextEntry())files.put(e.getName(),new String(z.readAllBytes(),StandardCharsets.UTF_8));}}return files;
+    }
+    static double[] doubles(String value){return Arrays.stream(value.split(",")).mapToDouble(Double::parseDouble).toArray();}
+    static SampleSizeWeightedMetaAnalysis.Result compute(String[] c){
+        double[] values=doubles(c[2]),weights=doubles(c[4]);int[] signs=c[3].isEmpty()?new int[0]:Arrays.stream(c[3].split(",")).mapToInt(Integer::parseInt).toArray();
+        return switch(c[1]){case "z"->SampleSizeWeightedMetaAnalysis.fitSignedZ(values,weights);case "p"->SampleSizeWeightedMetaAnalysis.fitPValues(values,signs,weights);case "logp"->SampleSizeWeightedMetaAnalysis.fitLogPValues(values,signs,weights);default->throw new IllegalArgumentException("Unknown reference mode");};
+    }
+    static Map<String,Object> flatten(SampleSizeWeightedMetaAnalysis.Result r)throws Exception {
+        var out=new TreeMap<String,Object>();for(var c:r.getClass().getRecordComponents()){Object value=c.getAccessor().invoke(r);if(value!=null&&value.getClass().isArray()){for(int i=0;i<Array.getLength(value);i++)out.put(c.getName()+"."+i,Array.get(value,i));}else out.put(c.getName(),value);}return out;
+    }
+    @Test void independentR69FiniteModelsAndOneRetainedNoResultCase()throws Exception {
+        var f=fixtures();var expected=new HashMap<String,Map<String,String>>();for(String line:f.get("expected.tsv").lines().skip(1).toList()){var c=line.split("\t");assertNull(expected.computeIfAbsent(c[0],k->new LinkedHashMap<>()).put(c[1],c[2]));}
+        int finite=0,refused=0,compared=0,unrepresentableFields=0;
+        for(String line:f.get("cases.tsv").lines().skip(1).toList()){
+            String[] c=line.split("\t",-1);var oracle=expected.get(c[0]);assertNotNull(oracle);
+            if(c[5].equals("refuse-unrepresentable")){var error=assertThrows(ArithmeticException.class,()->compute(c));assertTrue(error.getMessage().contains("Unrepresentable"));assertTrue(oracle.values().stream().anyMatch(v->v.equals("Inf")||v.equals("-Inf")));refused++;unrepresentableFields+=oracle.size();continue;}
+            var actual=flatten(compute(c));for(var e:oracle.entrySet()){String label=c[0]+" "+e.getKey();assertTrue(actual.containsKey(e.getKey()),label);Object observed=actual.get(e.getKey());String wanted=e.getValue();compared++;if(wanted.equals("NA")){assertNull(observed,label);continue;}assertNotNull(observed,label);if(observed instanceof Boolean flag){assertEquals(wanted.equals("1"),flag,label);continue;}double a=Double.parseDouble(wanted),v=((Number)observed).doubleValue();assertTrue(Double.isFinite(a)&&Double.isFinite(v),label);double tolerance=a==0?2e-13:Math.max(4*Math.ulp(a),5e-11*Math.abs(a));if(Set.of("homogeneous","underflow").contains(c[0])&&(e.getKey().equals("heterogeneityQ")||e.getKey().startsWith("heterogeneityContributions.")))tolerance=Math.max(tolerance,2e-25);assertEquals(a,v,tolerance,label);}
+            finite++;
+        }
+        assertEquals(69,finite);assertEquals(1,refused);assertEquals(1844,compared);assertEquals(20,unrepresentableFields);System.out.println("Independent R:69 finite models/1844 fields;1 retained unrepresentable model/20 raw diagnostics");
+    }
+    @Test void cancellationRetainsHeterogeneityAndCorrectDegreesOfFreedom(){
+        var r=SampleSizeWeightedMetaAnalysis.fitSignedZ(new double[]{2,-2},new double[]{25,25});assertEquals(0,r.z());assertEquals(1,r.pValue());assertEquals(50,r.totalWeight());assertEquals(8,r.heterogeneityQ(),1e-14);assertEquals(1,r.heterogeneityDegreesOfFreedom());assertEquals(87.5,r.iSquaredPercent(),1e-12);assertTrue(r.heterogeneityDefined());assertFalse(r.pValueUnderflow());
+    }
+    @Test void aSingleStudyDoesNotInventAHeterogeneityTest(){
+        var r=SampleSizeWeightedMetaAnalysis.fitSignedZ(new double[]{-3},new double[]{.5});assertEquals(-3,r.z());assertEquals(.5,r.totalWeight());assertEquals(0,r.heterogeneityQ());assertFalse(r.heterogeneityDefined());assertNull(r.heterogeneityPValue());assertNull(r.heterogeneityLogPValue());assertNull(r.iSquaredPercent());assertFalse(r.heterogeneityPValueUnderflow());
+    }
+    @Test void logProbabilitiesRetainUnderflowWithoutSubstitutingAPValueFloor(){
+        var r=SampleSizeWeightedMetaAnalysis.fitLogPValues(new double[]{-10000},new int[]{-1},new double[]{100});assertEquals(0,r.pValue());assertTrue(r.pValueUnderflow());assertTrue(Double.isFinite(r.logPValue()));assertEquals(-10000,r.logPValue(),1e-8);assertTrue(r.z()<-100);assertThrows(IllegalArgumentException.class,()->SampleSizeWeightedMetaAnalysis.fitPValues(new double[]{0},new int[]{1},new double[]{100}));
+        var smallest=SampleSizeWeightedMetaAnalysis.fitPValues(new double[]{Double.MIN_VALUE},new int[]{1},new double[]{100});assertTrue(Double.isFinite(smallest.studyZ()[0]));assertEquals(Math.log(Double.MIN_VALUE),smallest.logPValue(),1e-8);
+    }
+    @Test void invalidMissingAndUnrepresentableInputsNeverDropCohorts(){
+        for(double bad:new double[]{Double.NaN,Double.POSITIVE_INFINITY,0,-1})assertThrows(IllegalArgumentException.class,()->SampleSizeWeightedMetaAnalysis.fitSignedZ(new double[]{1,2},new double[]{100,bad}));
+        for(double bad:new double[]{Double.NaN,Double.NEGATIVE_INFINITY})assertThrows(IllegalArgumentException.class,()->SampleSizeWeightedMetaAnalysis.fitSignedZ(new double[]{1,bad},new double[]{100,100}));
+        assertThrows(IllegalArgumentException.class,()->SampleSizeWeightedMetaAnalysis.fitSignedZ(new double[0],new double[0]));assertThrows(IllegalArgumentException.class,()->SampleSizeWeightedMetaAnalysis.fitPValues(new double[]{.05},new int[]{0},new double[]{100}));assertThrows(IllegalArgumentException.class,()->SampleSizeWeightedMetaAnalysis.fitLogPValues(new double[]{Double.NEGATIVE_INFINITY},new int[]{1},new double[]{100}));
+        assertThrows(ArithmeticException.class,()->SampleSizeWeightedMetaAnalysis.fitSignedZ(new double[]{1,1},new double[]{Double.MAX_VALUE,Double.MAX_VALUE}));assertThrows(ArithmeticException.class,()->SampleSizeWeightedMetaAnalysis.fitSignedZ(new double[]{1e308,0},new double[]{Double.MIN_VALUE,1e308}));
+    }
+    @Test void capacityRefusesTheCompletePopulationBeforeStatistics(){
+        assertThrows(IllegalArgumentException.class,()->SampleSizeWeightedMetaAnalysis.fitSignedZ(new double[]{1,2},new double[]{100,100},new SampleSizeWeightedMetaAnalysis.Limits(1,1<<20)));assertThrows(IllegalArgumentException.class,()->SampleSizeWeightedMetaAnalysis.fitPValues(new double[]{.5,.5},new int[]{1,-1},new double[]{100,100},new SampleSizeWeightedMetaAnalysis.Limits(100,8192)));
+    }
+    @Test void inputsAndAllReturnedDiagnosticArraysAreOwned()throws Exception {
+        double[] z={1,-2,3},weights={100,200,300};var result=SampleSizeWeightedMetaAnalysis.fitSignedZ(z,weights);assertArrayEquals(new double[]{1,-2,3},z);assertArrayEquals(new double[]{100,200,300},weights);var before=flatten(result);for(var c:result.getClass().getRecordComponents()){Object value=c.getAccessor().invoke(result);if(value instanceof double[] a)a[0]=Double.NaN;}assertEquals(before,flatten(result));z[0]=99;weights[0]=0;assertEquals(1,result.studyZ()[0]);assertEquals(3,result.studies());
+    }
+}
