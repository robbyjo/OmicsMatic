{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robbyjo.github.io/JLinAlg/schemas/public-literature-context-v1.schema.json",
  "title": "Explicit public literature context for impact review and manuscript drafting",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sources"],
  "properties": {
    "schema_version": {"const": 1},
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "hypotheses", "purposes", "reference", "reference_bundle", "source_id", "source_sha256", "passages"],
        "properties": {
          "id": {"$ref": "#/$defs/identifier"},
          "hypotheses": {"$ref": "#/$defs/nonemptyLabels"},
          "feature_ids": {"$ref": "#/$defs/labels"},
          "purposes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["impact", "manuscript"]}},
          "reference": {"type": "string", "minLength": 1, "maxLength": 8000},
          "reference_bundle": {
            "type": "object",
            "additionalProperties": false,
            "required": ["manifest", "sha256"],
            "properties": {
              "manifest": {"type": "string", "minLength": 1, "maxLength": 8000},
              "sha256": {"$ref": "#/$defs/sha256"}
            }
          },
          "source_id": {"type": "string", "minLength": 1, "maxLength": 8000},
          "source_sha256": {"$ref": "#/$defs/sha256"},
          "passages": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "start", "end"],
              "properties": {
                "id": {"$ref": "#/$defs/identifier"},
                "start": {"type": "integer", "minimum": 0, "maximum": 2147483647},
                "end": {"type": "integer", "minimum": 1, "maximum": 2147483647}
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,99}$"},
    "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "labels": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 500, "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"}},
    "nonemptyLabels": {"allOf": [{"$ref": "#/$defs/labels"}, {"minItems": 1}]}
  },
  "description": "The native reader additionally verifies the exact context/bundle/text hashes, known hypothesis scope, full-text inventory membership and reference identity, globally unique source IDs, unique passage IDs/ranges, valid UTF-16 boundaries and a 2000000-character total. Integrity checks and caller selection do not establish scientific support or authorize additional purposes."
}
