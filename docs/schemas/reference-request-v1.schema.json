{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robbyjo.github.io/JLinAlg/schemas/reference-request-v1.schema.json",
  "title": "Public DOI/PMID reference request",
  "description": "Explicit full_text requests use the same configured public-network/download policy. Bibliographic completion and full-text availability are recorded separately.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "references": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "full_text": {
            "type": "boolean",
            "default": false
          }
        },
        "required": [
          "id",
          "rationale"
        ]
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "references"
  ]
}
