  "glasso_formals": "as.pairlist(alist(s = , rho = , nobs = NULL, zero = NULL, thr = 1e-04, maxit = 10000, approx = FALSE, penalize.diagonal = TRUE, start = c(\"cold\", \n    \"warm\"), w.init = NULL, wi.init = NULL, trace = FALSE))",
  "cov2cor_body": "{\n    p <- (d <- dim(V))[1L]\n    if (!is.numeric(V) || length(d) != 2L || p != d[2L]) \n        stop(\"'V' is not a square numeric matrix\")\n    pos <- !is.na(Is <- D <- diag(V, names = FALSE)) & D > 0\n    Is[pos] <- sqrt(1/D[pos])\n    Is[!pos] <- NaN\n    if (any(!pos) || any(!is.finite(Is))) \n        warning(\"diag(V) had non-positive or NA entries; the non-finite result may be dubious\")\n    r <- V\n    r[] <- Is * V * rep(Is, each = p)\n    if (p) \n        r[seq.int(from = 1L, by = p + 1L, length.out = p)] <- 1\n    r\n}",
