  "unreported_author_editions_inferred": false,
  "author_Python37_reproduced": false,
  "source_programs_rewritten": false,
  "known_source_behavior": [
    "0.5.2 top-level --version can exit0 without a version report; probe original __version__ and functional outputs instead.",
    "0.6.3 VCF conversion requires contig metadata or fails before conversion; preserve incomplete outputs.",
    "Both original editions reject the tested valid reverse multiblock BED12 instead of producing sorted target exons.",
    "0.5.2 preserves old indel ALT anchors;0.6.3 updates their first nucleotide before any reverse complement.",
    "BigWig intervals with no single mapping are discarded by original source; overlapping retained target signals are summed. All-unmapped tracks fail in the original merge routine."
  ]
}
